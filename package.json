{
  "name": "dystopia-the-waking",
  "private": true,
  "version": "1.0.0",
  "description": "DYSTOPIA: The Waking web game and Capacitor shells for iOS and Android.",
  "scripts": {
    "build:www": "node tools/build-www.mjs",
    "build:www:play": "PLAY_BUILD=1 node tools/build-www.mjs",
    "check:offline": "node tools/check-offline.mjs",
    "check:full": "node tools/full-run.mjs",
    "check:return": "node tools/check-return.mjs",
    "cap:sync": "npm run build:www && cap sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3"
  }
}
